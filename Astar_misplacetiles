        "import heapq\n",
        "\n",
        "GOAL = (\n",
        "    1, 2, 3,\n",
        "    8, 0, 4,\n",
        "    7, 6, 5\n",
        ")\n",
        "\n",
        "\n",
        "def heuristic(state):\n",
        "    return sum(\n",
        "        tile != goal and tile != 0\n",
        "        for tile, goal in zip(state, GOAL)\n",
        "    )\n",
        "\n",
        "\n",
        "def neighbors(state):\n",
        "    zero = state.index(0)\n",
        "    row, col = divmod(zero, 3)\n",
        "\n",
        "    moves = [\n",
        "        (-1, 0),\n",
        "        (1, 0),\n",
        "        (0, -1),\n",
        "        (0, 1)\n",
        "    ]\n",
        "\n",
        "    for dr, dc in moves:\n",
        "        new_row = row + dr\n",
        "        new_col = col + dc\n",
        "\n",
        "        if 0 <= new_row < 3 and 0 <= new_col < 3:\n",
        "            new_state = list(state)\n",
        "            new_zero = new_row * 3 + new_col\n",
        "\n",
        "            new_state[zero], new_state[new_zero] = (\n",
        "                new_state[new_zero],\n",
        "                new_state[zero]\n",
        "            )\n",
        "\n",
        "            yield tuple(new_state)\n",
        "\n",
        "\n",
        "def inversions(state):\n",
        "    tiles = [tile for tile in state if tile != 0]\n",
        "\n",
        "    return sum(\n",
        "        tiles[i] > tiles[j]\n",
        "        for i in range(len(tiles))\n",
        "        for j in range(i + 1, len(tiles))\n",
        "    )\n",
        "\n",
        "\n",
        "def solvable(state):\n",
        "    return inversions(state) % 2 == inversions(GOAL) % 2\n",
        "\n",
        "\n",
        "def astar(start):\n",
        "    priority_queue = [\n",
        "        (heuristic(start), 0, start, [start])\n",
        "    ]\n",
        "\n",
        "    visited = {start: 0}\n",
        "\n",
        "    while priority_queue:\n",
        "        f, g, state, path = heapq.heappop(priority_queue)\n",
        "\n",
        "        if state == GOAL:\n",
        "            return path\n",
        "\n",
        "        for new_state in neighbors(state):\n",
        "            new_cost = g + 1\n",
        "\n",
        "            if (\n",
        "                new_state not in visited\n",
        "                or new_cost < visited[new_state]\n",
        "            ):\n",
        "                visited[new_state] = new_cost\n",
        "\n",
        "                heapq.heappush(\n",
        "                    priority_queue,\n",
        "                    (\n",
        "                        new_cost + heuristic(new_state),\n",
        "                        new_cost,\n",
        "                        new_state,\n",
        "                        path + [new_state]\n",
        "                    )\n",
        "                )\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def print_board(state):\n",
        "    for i in range(0, 9, 3):\n",
        "        print(\n",
        "            \" \".join(\n",
        "                str(tile) if tile != 0 else \" \"\n",
        "                for tile in state[i:i + 3]\n",
        "            )\n",
        "        )\n",
        "\n",
        "    print(\"-\" * 9)\n",
        "\n",
        "\n",
        "while True:\n",
        "    try:\n",
        "        state = tuple(\n",
        "            map(int, input(\"Enter 9 numbers: \").split())\n",
        "        )\n",
        "\n",
        "        if len(state) != 9 or sorted(state) != list(range(9)):\n",
        "            print(\"Enter numbers 0 to 8 exactly once.\\n\")\n",
        "            continue\n",
        "\n",
        "        break\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Enter integers only.\\n\")\n",
        "\n",
        "\n",
        "print(\"\\nInitial State:\")\n",
        "print_board(state)\n",
        "\n",
        "print(\"Goal State:\")\n",
        "print_board(GOAL)\n",
        "\n",
        "if not solvable(state):\n",
        "    print(\"This puzzle configuration is unsolvable.\")\n",
        "\n",
        "else:\n",
        "    print(\"Solvability check passed!\")\n",
        "    print(\"Solving using A* Search...\\n\")\n",
        "\n",
        "    solution = astar(state)\n",
        "\n",
        "    if solution:\n",
        "        print(f\"Solution found in {len(solution) - 1} steps!\\n\")\n",
        "\n",
        "        for step, state in enumerate(solution):\n",
        "            print(f\"Step {step}:\")\n",
        "            print_board(state)\n",
        "\n",
        "    else:\n",
        "        print(\"No solution found.\")"
      ]
